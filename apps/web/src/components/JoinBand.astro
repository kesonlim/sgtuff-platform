---
import LeadForm from '@/components/LeadForm';
import { joinFields } from '@/components/forms';
import { SITE } from '@/lib/site';
---
<section id="join" class="bg-foreground text-background">
  <div class="container-page grid gap-12 py-20 lg:grid-cols-[1fr_1.1fr] lg:py-24">
    <div class="flex flex-col gap-6">
      <p class="eyebrow text-accent">Membership</p>
      <h2 class="font-condensed text-5xl leading-[0.92] sm:text-6xl">Don’t negotiate <span class="text-primary">alone.</span></h2>
      <ul class="flex flex-col gap-4 text-lg text-ink-soft">
        <li class="border-t border-ink-line pt-4"><strong class="text-background">A collective voice</strong> on leases, renewals and manpower policy.</li>
        <li class="border-t border-ink-line pt-4"><strong class="text-background">Practical know-how:</strong> Fair Tenancy training and lease benchmarks.</li>
        <li class="border-t border-ink-line pt-4"><strong class="text-background">Real benefits</strong> for your staff, like our eldercare support programme.</li>
      </ul>
    </div>
    <div class="rounded-md bg-background p-6 text-foreground sm:p-8">
      <LeadForm
        client:visible
        endpoint="/api/join"
        fields={joinFields}
        submitLabel="Join SGTUFF"
        successTitle="Welcome aboard."
        successBody="Thanks for joining. Our team will contact you within a few working days with next steps."
        footnote="We only use your details to process your membership."
        turnstileSiteKey={SITE.turnstileSiteKey}
      />
    </div>
  </div>
</section>
