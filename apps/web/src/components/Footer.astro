---
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();

const groups = [
  { title: 'The co-op', links: [
    { label: 'Our Story & Wins', href: '/about-us' },
    { label: 'Membership', href: '/membership' },
    { label: 'Business Network', href: '/business-network' },
    { label: 'Partner with us', href: '/collaborate' },
    { label: 'News', href: '/latest-news' },
  ] },
  { title: 'Help for tenants', links: [
    { label: 'Fair Tenancy', href: '/fair-tenancy' },
    { label: 'Retail Tracker ↗', href: SITE.trackerUrl },
    { label: 'Member log-in', href: SITE.memberLoginUrl },
    { label: 'Contact us', href: '/contact' },
  ] },
];
---
<footer class="bg-foreground text-ink-soft">
  <div class="container-page grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-4">
      <img src="/brand/sgtuff-wordmark-night-unity.svg" alt="SGTUFF" width="136" height="26" class="h-[26px] w-auto self-start" />
      <p class="text-[14px] leading-relaxed">{SITE.legalName}<br />A registered co-operative society<br />UEN {SITE.uen}<br />{SITE.address}</p>
      <p class="font-display text-xl font-bold text-background">Tough together.</p>
    </div>
    {groups.map((g) => (
      <nav aria-label={g.title}>
        <p class="eyebrow mb-3 text-background">{g.title}</p>
        <ul class="flex flex-col gap-2 text-[14px]">
          {g.links.map((l) => <li><a href={l.href} class="text-ink-soft no-underline hover:text-background">{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
    <div class="flex flex-col gap-2 text-[14px]">
      <p class="eyebrow mb-1 text-background">Contact</p>
      <a href={`mailto:${SITE.email}`} class="text-background no-underline hover:text-accent">{SITE.email}</a>
      <a href={`https://wa.me/${SITE.phone.replace(/\D/g, '')}`} class="text-background no-underline hover:text-accent">WhatsApp {SITE.phone}</a>
      <ul class="mt-3 flex flex-wrap gap-2">
        {SITE.socials.map((s) => (
          <li><a href={s.href} rel="noopener" target="_blank" class="inline-flex h-11 items-center rounded-full border border-ink-line px-4 text-[13px] text-background no-underline hover:border-background hover:text-background">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-line">
    <div class="container-page flex flex-col gap-2 py-6 text-[13px] sm:flex-row sm:justify-between">
      <p>© {year} SGTUFF · Unity is Strength</p>
      <p>Representing {SITE.stats.owners} owners, {SITE.stats.brands} brands and {SITE.stats.outlets} outlets (as of {SITE.stats.asOf})</p>
    </div>
  </div>
</footer>
