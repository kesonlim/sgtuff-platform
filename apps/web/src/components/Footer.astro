---
import { NAV, SITE } from '@/lib/site';
const year = new Date().getFullYear();
---
<footer class="bg-foreground text-ink-soft">
  <div class="container-page grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-3 lg:col-span-2">
      <p class="font-condensed text-4xl leading-none text-background">Fair rent.<br />Fair rules.<br /><span class="text-primary">Fair play.</span></p>
      <p class="max-w-md text-[15px]">{SITE.mission}</p>
    </div>
    <nav aria-label="Footer">
      <p class="eyebrow mb-3 text-background">Site</p>
      <ul class="flex flex-col gap-2 text-[15px]">
        {NAV.map((n) => <li><a href={n.href} class="text-ink-soft no-underline hover:text-background">{n.label}</a></li>)}
        <li><a href="/contact" class="text-ink-soft no-underline hover:text-background">Contact</a></li>
      </ul>
    </nav>
    <div class="flex flex-col gap-2 text-[15px]">
      <p class="eyebrow mb-1 text-background">Contact</p>
      <a href={`mailto:${SITE.email}`} class="text-background no-underline hover:text-accent">{SITE.email}</a>
      <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="text-background no-underline hover:text-accent">{SITE.phone}</a>
      <ul class="mt-3 flex flex-wrap gap-2">
        {SITE.socials.map((s) => (
          <li><a href={s.href} rel="noopener" target="_blank" class="inline-flex h-11 items-center rounded-full border border-ink-line px-4 text-[14px] text-background no-underline hover:border-background hover:text-background">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-line">
    <div class="container-page flex flex-col gap-2 py-6 text-[13px] sm:flex-row sm:justify-between">
      <p>© {year} {SITE.legalName}</p>
      <p>Registered co-operative {SITE.regNo}</p>
    </div>
  </div>
</footer>
