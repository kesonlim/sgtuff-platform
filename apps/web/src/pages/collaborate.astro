---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm';
import { collaborateFields } from '@/components/forms';
import { SITE } from '@/lib/site';
---
<Base title="Collaborate with us" description="Partner with SGTUFF: agencies, landlords, trade associations, media and technology providers.">
  <PageHero eyebrow="Collaborate" title="Let’s build fairer retail." lede="We work with government agencies, landlords, trade associations, media and technology providers." />
  <section class="container-page grid gap-12 py-20 lg:grid-cols-[1fr_1.3fr]">
    <div class="flex flex-col gap-4">
      <h2 class="font-display text-3xl font-extrabold">Partner with SGTUFF</h2>
      <p class="text-body">Have an idea that helps SME tenants? Tell us about it and the right person will get back to you.</p>
      <p class="text-body">Prefer email? <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <div class="rounded-md border-2 border-foreground p-6 sm:p-8">
      <LeadForm
        client:visible
        endpoint="/api/collaborate"
        fields={collaborateFields}
        submitLabel="Send proposal"
        successTitle="Proposal received."
        successBody="Thank you. We’ll review it and get back to you."
        turnstileSiteKey={SITE.turnstileSiteKey}
      />
    </div>
  </section>
</Base>
