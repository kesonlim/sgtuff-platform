---
import { Check } from 'lucide-react';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { buttonVariants } from '@/components/ui/button';
import { SITE } from '@/lib/site';

const tiers = [
  { name: 'Ordinary member', for: 'SME owners in retail, F&B, wellness and services.', perks: ['Voting rights at the AGM', 'Lease benchmarks and guidance', 'Member benefits and programmes'], cta: { label: 'Join now', href: '/join' }, featured: true },
  { name: 'Associate member', for: 'Aspiring entrepreneurs, retail managers and industry professionals.', perks: ['Fair Tenancy workshops', 'Networking events', 'Retail movement updates'], cta: { label: 'Join now', href: '/join' } },
  { name: 'Corporate partner', for: 'Service providers, technology vendors, law firms and sponsors.', perks: ['Listing in the Business Network', 'Sponsorship opportunities', 'Reach SME operators directly'], cta: { label: 'Partner with us', href: '/collaborate' } },
];
---
<Base title="Membership" description="Join SGTUFF, Singapore's co-operative for SME tenants in retail, F&B and services.">
  <PageHero eyebrow="Membership" title="Stronger together." lede="Pick the membership that fits you. Already a member? Log in to the member portal.">
    <a href={SITE.memberLoginUrl} class={buttonVariants({ variant: 'outline', className: 'self-start' })}>Member login ↗</a>
  </PageHero>

  <section class="container-page grid gap-6 py-20 md:grid-cols-3">
    {tiers.map((t) => (
      <div class:list={['flex flex-col gap-5 rounded-md p-8', t.featured ? 'bg-foreground text-background' : 'border-2 border-foreground']}>
        <h2 class="font-display text-2xl font-extrabold">{t.name}</h2>
        <p class:list={[t.featured ? 'text-ink-soft' : 'text-body']}>{t.for}</p>
        <ul class="flex flex-col gap-3">
          {t.perks.map((p) => (
            <li class="flex gap-3"><Check className="mt-1 size-5 shrink-0 text-primary" aria-hidden="true" />{p}</li>
          ))}
        </ul>
        <a href={t.cta.href} class={buttonVariants({ variant: t.featured ? 'primary' : 'outline', className: 'mt-auto' })}>{t.cta.label}</a>
      </div>
    ))}
  </section>
</Base>
