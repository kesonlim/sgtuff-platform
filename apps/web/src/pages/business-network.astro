---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { PAGES } from '@/lib/site';
import JoinBand from '@/components/JoinBand.astro';
---
<Base title="Business Network" description="The SGTUFF Business Network connects SME operators to share know-how, suppliers and opportunities.">
  <PageHero eyebrow={PAGES.businessNetwork.eyebrow} title={PAGES.businessNetwork.title} lede={PAGES.businessNetwork.lede} />
  <section class="container-page grid gap-12 py-20 lg:grid-cols-2">
    <div class="flex flex-col gap-4">
      <h2 class="font-display text-3xl font-extrabold">Share what works</h2>
      <p class="text-body">Members swap operational insights, staffing solutions and supplier contacts with people who face the same challenges.</p>
    </div>
    <div class="flex flex-col gap-4">
      <h2 class="font-display text-3xl font-extrabold">Buy together</h2>
      <p class="text-body">By pooling demand, members can access better terms from partners on the things every shop needs.</p>
    </div>
  </section>
  <JoinBand />
</Base>
